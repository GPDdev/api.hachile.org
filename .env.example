# Generate once on the server: openssl rand -hex 32
# Keep the resulting value across container replacements.
SESSION_SECRET=

# Verify the network shared by the 1Panel OpenResty container before starting.
PROXY_NETWORK=1panel-network

# Set an exact reverse-proxy address after inspecting its Docker network.
# Until then forwarded client-IP headers are not trusted.
TRUSTED_PROXIES=none
